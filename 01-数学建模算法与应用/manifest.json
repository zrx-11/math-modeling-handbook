  "glossary": [
    {
      "term": "线性规划",
      "def": "目标与约束都是一次式的优化问题，可行域为凸多边形",
      "chapterId": "ch01"
    },
    {
      "term": "标准型",
      "def": "目标最大化、约束全为 ≤、变量非负的统一写法",
      "chapterId": "ch01"
    },
    {
      "term": "可行域",
      "def": "所有满足约束的点组成的集合",
      "chapterId": "ch01"
    },
    {
      "term": "顶点",
      "def": "两条约束线的交点，线性规划最优解的候选位置",
      "chapterId": "ch01"
    },
    {
      "term": "松弛变量",
      "def": "把 ≤ 约束变成等式的非负辅助变量",
      "chapterId": "ch01"
    },
    {
      "term": "影子价格",
      "def": "约束右端项加一单位带来的目标增量，等于对偶变量",
      "chapterId": "ch01"
    },
    {
      "term": "整数规划",
      "def": "要求部分或全部变量取整数的规划问题",
      "chapterId": "ch02"
    },
    {
      "term": "0-1 变量",
      "def": "只取 0 或 1 的变量，用来表示选或不选",
      "chapterId": "ch02"
    },
    {
      "term": "分枝定界",
      "def": "用线性松弛解作上界、逐变量分枝搜索整数解的方法",
      "chapterId": "ch02"
    },
    {
      "term": "指派问题",
      "def": "n 人做 n 事、每人一事、每事一人的 0-1 规划",
      "chapterId": "ch02"
    },
    {
      "term": "非线性规划",
      "def": "目标或约束含非线性项的优化问题",
      "chapterId": "ch03"
    },
    {
      "term": "凸函数",
      "def": "图像呈碗形、任意两点连线在图像上方的函数",
      "chapterId": "ch03"
    },
    {
      "term": "凸规划",
      "def": "目标凸且可行域凸的规划，局部最优即全局最优",
      "chapterId": "ch03"
    },
    {
      "term": "KKT 条件",
      "def": "带约束极值点必须满足的梯度平衡与互补松弛条件",
      "chapterId": "ch03"
    },
    {
      "term": "互补松弛",
      "def": "约束未起作用时对应乘子为零的条件，λᵢgᵢ = 0",
      "chapterId": "ch03"
    },
    {
      "term": "二次规划",
      "def": "二次目标加线性约束的优化问题",
      "chapterId": "ch03"
    },
    {
      "term": "罚函数法",
      "def": "把约束违反量加进目标函数、用大系数逼迫可行的办法",
      "chapterId": "ch03"
    },
    {
      "term": "邻接矩阵",
      "def": "用矩阵元素表示两点之间有无边或权值的存图方式",
      "chapterId": "ch04"
    },
    {
      "term": "最短路",
      "def": "两点之间总权值最小的路径",
      "chapterId": "ch04"
    },
    {
      "term": "最小生成树",
      "def": "连通全部点且总权值最小的无环子图",
      "chapterId": "ch04"
    },
    {
      "term": "最大流",
      "def": "源点到汇点在不超容量的前提下能输送的最大流量",
      "chapterId": "ch04"
    },
    {
      "term": "关键路径",
      "def": "项目中总时差为零、决定总工期的工序链",
      "chapterId": "ch04"
    },
    {
      "term": "TSP",
      "def": "遍历所有点各一次并回到起点的最短回路问题",
      "chapterId": "ch04"
    },
    {
      "term": "插值",
      "def": "构造必须经过全部已知点的曲线",
      "chapterId": "ch05"
    },
    {
      "term": "拟合",
      "def": "不要求穿过点、只要求残差平方和最小的近似",
      "chapterId": "ch05"
    },
    {
      "term": "Runge 现象",
      "def": "等距节点上高次插值在区间边缘剧烈振荡",
      "chapterId": "ch05"
    },
    {
      "term": "三次样条",
      "def": "分段三次多项式且在节点处一二阶导数连续",
      "chapterId": "ch05"
    },
    {
      "term": "最小二乘",
      "def": "使残差平方和最小来估计参数的准则",
      "chapterId": "ch05"
    },
    {
      "term": "微分方程",
      "def": "含未知函数及其导数的方程，描述变化机制",
      "chapterId": "ch06"
    },
    {
      "term": "初值条件",
      "def": "给定某时刻状态、决定落在哪条解曲线上的条件",
      "chapterId": "ch06"
    },
    {
      "term": "Euler 法",
      "def": "用当前斜率直线外推的一阶数值解法",
      "chapterId": "ch06"
    },
    {
      "term": "RK4",
      "def": "每步四次求斜率再加权的四阶数值解法",
      "chapterId": "ch06"
    },
    {
      "term": "SIR 模型",
      "def": "把人群分为易感、感染、康复三类的传染病模型",
      "chapterId": "ch06"
    },
    {
      "term": "基本再生数",
      "def": "R₀ = β/γ，一个感染者平均传染的人数",
      "chapterId": "ch06"
    },
    {
      "term": "点估计",
      "def": "用样本统计量直接猜总体参数",
      "chapterId": "ch07"
    },
    {
      "term": "区间估计",
      "def": "给出覆盖真值的概率范围的估计方法",
      "chapterId": "ch07"
    },
    {
      "term": "p 值",
      "def": "H₀ 为真时出现当前或更极端结果的概率",
      "chapterId": "ch07"
    },
    {
      "term": "Bootstrap",
      "def": "有放回重抽样模拟抽样分布的方法",
      "chapterId": "ch07"
    },
    {
      "term": "方差分析",
      "def": "把总变异拆成组间与组内、用 F 检验比较均值的办法",
      "chapterId": "ch07"
    },
    {
      "term": "差分方程",
      "def": "描述相邻两期数值关系的方程",
      "chapterId": "ch08"
    },
    {
      "term": "平衡点",
      "def": "使下一期等于本期、系统不再变化的取值",
      "chapterId": "ch08"
    },
    {
      "term": "稳定性",
      "def": "初值小扰动会随时间消失的性质",
      "chapterId": "ch08"
    },
    {
      "term": "Leslie 矩阵",
      "def": "由繁殖率首行与存活率次对角线构成的种群投影矩阵",
      "chapterId": "ch08"
    },
    {
      "term": "支持向量机",
      "def": "最大化分类间隔的二分类模型",
      "chapterId": "ch09"
    },
    {
      "term": "间隔",
      "def": "两类支持向量之间的距离，等于 2/‖w‖（规范化情形）",
      "chapterId": "ch09"
    },
    {
      "term": "支持向量",
      "def": "离分类超平面最近、决定边界的样本点",
      "chapterId": "ch09"
    },
    {
      "term": "软间隔",
      "def": "允许个别样本越界的 SVM 形式，由 C 控制容忍度",
      "chapterId": "ch09"
    },
    {
      "term": "核函数",
      "def": "隐式把样本映射到高维、只需算内积的函数",
      "chapterId": "ch09"
    },
    {
      "term": "聚类",
      "def": "无标签、按相似度把样本分组的分析",
      "chapterId": "ch10"
    },
    {
      "term": "K-means",
      "def": "迭代更新 k 个中心、按最近中心分组的聚类算法",
      "chapterId": "ch10"
    },
    {
      "term": "主成分分析",
      "def": "把变量线性组合成少数互不相关新变量的降维方法",
      "chapterId": "ch10"
    },
    {
      "term": "贡献率",
      "def": "某主成分特征值占特征值总和的比例",
      "chapterId": "ch10"
    },
    {
      "term": "判别分析",
      "def": "有标签、学习分类规则并给新样本归类的分析",
      "chapterId": "ch10"
    },
    {
      "term": "因子分析",
      "def": "假设少数潜在因子生成观测变量的统计模型",
      "chapterId": "ch10"
    },
    {
      "term": "典型相关分析",
      "def": "找两组变量各自线性组合使相关系数最大",
      "chapterId": "ch10"
    },
    {
      "term": "多维标度",
      "def": "只凭距离矩阵反推低维坐标的方法",
      "chapterId": "ch10"
    },
    {
      "term": "多重共线性",
      "def": "自变量之间近似线性相关，导致系数估计不稳定",
      "chapterId": "ch11"
    },
    {
      "term": "方差膨胀因子",
      "def": "衡量某变量被其余变量解释程度的指标，VIF > 10 视为严重共线",
      "chapterId": "ch11"
    },
    {
      "term": "偏最小二乘",
      "def": "同时考虑 X 变异与 X–Y 相关来提取成分的回归方法",
      "chapterId": "ch11"
    },
    {
      "term": "VIP 值",
      "def": "变量重要性投影，大于 1 通常视为重要变量",
      "chapterId": "ch11"
    },
    {
      "term": "模拟退火",
      "def": "按 exp(−Δ/T) 概率接受差解的随机搜索算法",
      "chapterId": "ch12"
    },
    {
      "term": "遗传算法",
      "def": "用编码、适应度、选择、交叉、变异模拟进化的搜索算法",
      "chapterId": "ch12"
    },
    {
      "term": "精英保留",
      "def": "每代把最优个体直接复制到下一代，防止退化",
      "chapterId": "ch12"
    },
    {
      "term": "灰度化",
      "def": "把三通道彩色图按亮度权重合成单通道图",
      "chapterId": "ch13"
    },
    {
      "term": "空间滤波",
      "def": "用小窗口在图上滑动做加权和的处理方式",
      "chapterId": "ch13"
    },
    {
      "term": "中值滤波",
      "def": "取窗口内中位数作为中心像素值的非线性滤波",
      "chapterId": "ch13"
    },
    {
      "term": "直方图均衡",
      "def": "按累计分布重排灰度、使直方图平坦的对比度增强",
      "chapterId": "ch13"
    },
    {
      "term": "LSB 水印",
      "def": "把信息写入像素最低位的隐蔽水印方法",
      "chapterId": "ch13"
    },
    {
      "term": "综合评价",
      "def": "多指标标准化加权后排序的方法体系",
      "chapterId": "ch14"
    },
    {
      "term": "极差标准化",
      "def": "用 (x−min)/(max−min) 把指标压到 0–1 区间",
      "chapterId": "ch14"
    },
    {
      "term": "熵权法",
      "def": "按指标区分度分配权重的客观赋权方法",
      "chapterId": "ch14"
    },
    {
      "term": "理想解法",
      "def": "按到正负理想解的距离排序的 TOPSIS 方法",
      "chapterId": "ch14"
    },
    {
      "term": "数据包络分析",
      "def": "用投入产出比评价决策单元效率的方法",
      "chapterId": "ch14"
    },
    {
      "term": "秩和比",
      "def": "用秩次合成评价结果、抗异常值的方法",
      "chapterId": "ch14"
    },
    {
      "term": "PageRank",
      "def": "按链接关系迭代给节点打分的排序算法",
      "chapterId": "ch14"
    },
    {
      "term": "灰色预测",
      "def": "用累加生成近似指数趋势、适合小样本的预测方法",
      "chapterId": "ch15"
    },
    {
      "term": "级比检验",
      "def": "GM(1,1) 建模前检查序列是否适合的比值判据",
      "chapterId": "ch15"
    },
    {
      "term": "马尔可夫链",
      "def": "下一状态只依赖当前状态、按转移概率演化的过程",
      "chapterId": "ch15"
    },
    {
      "term": "ARIMA",
      "def": "自回归差分移动平均模型",
      "chapterId": "ch15"
    },
    {
      "term": "样本外检验",
      "def": "留出末段数据不建模、用来评估预测能力",
      "chapterId": "ch15"
    },
    {
      "term": "MAPE",
      "def": "平均绝对百分比误差，衡量相对预测偏差",
      "chapterId": "ch15"
    },
    {
      "term": "多目标规划",
      "def": "同时优化多个可能冲突目标的规划问题",
      "chapterId": "ch16"
    },
    {
      "term": "Pareto 有效解",
      "def": "不存在全面更优解的非劣解",
      "chapterId": "ch16"
    },
